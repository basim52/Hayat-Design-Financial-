rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
    function isAllowedUser() {
      return request.auth != null && request.auth.token.email != null &&
        request.auth.token.email.lower() in ['basim5252@gmail.com', 'hayatalzaki@gmail.com'];
    }
    match /users/{userId} {
      allow read, write: if isAllowedUser() && request.auth.uid == userId;
      match /settings/{settingId} { allow read, write: if isAllowedUser() && request.auth.uid == userId; }
    }
    function sharedLedger() { return isAllowedUser(); }
    function validCreate() { return request.resource.data.userId == request.auth.uid; }
    function keepsCreator() { return request.resource.data.userId == resource.data.userId; }
    match /budgets/{id}  { allow read, delete: if sharedLedger(); allow create: if sharedLedger() && validCreate(); allow update: if sharedLedger() && keepsCreator(); }
    match /expenses/{id} { allow read, delete: if sharedLedger(); allow create: if sharedLedger() && validCreate(); allow update: if sharedLedger() && keepsCreator(); }
    match /revenues/{id} { allow read, delete: if sharedLedger(); allow create: if sharedLedger() && validCreate(); allow update: if sharedLedger() && keepsCreator(); }
    match /wastes/{id}   { allow read, delete: if sharedLedger(); allow create: if sharedLedger() && validCreate(); allow update: if sharedLedger() && keepsCreator(); }
    match /waste/{id}    { allow read, delete: if sharedLedger(); allow create: if sharedLedger() && validCreate(); allow update: if sharedLedger() && keepsCreator(); }
    match /invoices/{id} { allow read, delete: if sharedLedger(); allow create: if sharedLedger() && validCreate(); allow update: if sharedLedger() && keepsCreator(); }
  }
}
