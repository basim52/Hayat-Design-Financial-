{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User security configuration including salt and hashed PIN.",
      "type": "object",
      "properties": {
        "pinHash": { "type": "string", "description": "SHA-256 hashed 4-digit PIN." },
        "salt": { "type": "string", "description": "Cryptographic salt for PIN hashing." },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "StoreSettings": {
      "title": "Store Settings",
      "description": "Custom store branding, VAT details, currency, and invoice presets.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "currency": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "taxNumber": { "type": "string" },
        "taxRate": { "type": "number" },
        "logoPreset": { "type": "string" },
        "customLogoBase64": { "type": "string" }
      }
    },
    "BudgetTarget": {
      "title": "Monthly Budget Target",
      "description": "Planned budget for a specific category and month.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner of the budget." },
        "category": { "type": "string", "enum": ["materials", "marketing", "maintenance", "wages", "other"] },
        "amount": { "type": "number", "description": "Planned amount." },
        "month": { "type": "string", "format": "YYYY-MM", "description": "Target month." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "amount", "month", "createdAt"]
    },
    "Expense": {
      "title": "Actual Expense",
      "description": "Record of a specific spending.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string", "enum": ["materials", "marketing", "maintenance", "wages", "other"] },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "amount", "date", "createdAt"]
    },
    "Revenue": {
      "title": "Sales Record",
      "description": "Record of a sale or order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "amount": { "type": "number" },
        "productType": { "type": "string", "enum": ["acrylic", "wood", "svg", "other"] },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "productType", "date", "createdAt"]
    },
    "WasteItem": {
      "title": "Production Waste",
      "description": "Record of wasted materials during production.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "material": { "type": "string" },
        "estimatedCost": { "type": "number" },
        "reason": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "material", "estimatedCost", "date", "createdAt"]
    },
    "Invoice": {
      "title": "Invoice Record",
      "description": "Record of a customer invoice with multiple items, optional PDF logo and totals.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "dueDate": { "type": "string", "format": "date-time" },
        "items": { "type": "array" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "discount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "notes": { "type": "string" },
        "logoPreset": { "type": "string" },
        "customLogoBase64": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "invoiceNumber", "customerName", "date", "items", "grandTotal", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User security profile and PIN authentication credentials."
    },
    "users/{userId}/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Custom store configuration and preferences."
    },
    "budgets/{budgetId}": {
      "schema": "BudgetTarget",
      "description": "Collection of monthly budget targets."
    },
    "expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of actual expenses."
    },
    "revenues/{revenueId}": {
      "schema": "Revenue",
      "description": "Collection of sales revenues."
    },
    "wastes/{wasteId}": {
      "schema": "WasteItem",
      "description": "Collection of material waste records."
    },
    "invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of customer invoices."
    }
  }
}
